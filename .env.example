# Local PostgreSQL / TimescaleDB settings (used by docker-compose.yml)
POSTGRES_DB=telemetry
POSTGRES_USER=telemetry
POSTGRES_PASSWORD=telemetry

# Optional Phase 4 firmware .bin storage directory (defaults to ./data/firmware on host, /app/data/firmware in Docker)
# FIRMWARE_STORAGE_DIR=
# Optional LAN base URL advertised to ESP32 units inside MQTT OTA_UPDATE download links (e.g. http://192.168.1.50:3000)
# OTA_BASE_URL=

# Optional Phase 2 Remote HTTPS Access (docker compose --profile remote up -d)
# Create a Cloudflare Zero Trust Tunnel pointing to http://app:3000
CF_TOKEN=

# Optional Phase 2 Cloudflare Access JWT verification for /fleet and /api/fleet/*
# Leave both unset for zero-login local factory LAN mode.
# When enabling remote authentication, BOTH team domain and AUD tag must be set.
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=
# Optional comma-separated email allowlist (empty allows any user permitted by Cloudflare Access policy)
CF_ACCESS_ALLOWED_EMAILS=

# Optional Phase 3 Engineering Observability (docker compose --profile engineering up -d)
# Combine with --profile remote for Cloudflare Tunnel + Access HTTPS protection on Grafana
GRAFANA_PORT=3001
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
GRAFANA_ROOT_URL=http://localhost:3001
