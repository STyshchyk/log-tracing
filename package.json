{
  "name": "log-telemetry",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev": "tsx src/server.ts",
    "start": "node dist/src/server.js",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:smoke": "vitest run --config vitest.smoke.config.ts",
    "test:all": "vitest run && vitest run --config vitest.smoke.config.ts",
    "seed:pilot": "tsx src/db/seed-pilot-machines.ts",
    "seed:fleet": "tsx src/db/seed-fleet-machines.ts",
    "seed:full": "tsx src/db/seed-fleet-machines.ts"
  },
  "dependencies": {
    "@fastify/swagger": "^9.9.5",
    "@fastify/swagger-ui": "^6.1.4",
    "fastify": "^5.12.8",
    "mqtt": "^5.16.1",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  }
}
