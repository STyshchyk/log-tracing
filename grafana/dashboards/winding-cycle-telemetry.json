      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "telemetry-postgres"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT $__timeGroupAlias(co.created_at, $__interval),\n  AVG(co.duration_sec)::double precision AS avg_sec,\n  percentile_cont(0.5) WITHIN GROUP (ORDER BY co.duration_sec)::double precision AS p50_sec,\n  percentile_cont(0.95) WITHIN GROUP (ORDER BY co.duration_sec)::double precision AS p95_sec\nFROM coil_outcomes co\nINNER JOIN machines m ON m.id = co.machine_id\nWHERE $__timeFilter(co.created_at)\n  AND m.zone IN ($zone)\n  AND co.machine_id IN ($machine)\n  AND co.duration_sec IS NOT NULL\nGROUP BY 1\nORDER BY 1 ASC",
          "refId": "A"
        }
      ],
      "title": "Cycle Duration Trend — AVG / P50 / P95 (Seconds)",
      "type": "timeseries"
    },
