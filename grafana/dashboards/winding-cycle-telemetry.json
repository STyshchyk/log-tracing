          "rawQuery": true,
          "rawSql": "SELECT $__timeGroupAlias(co.created_at, $__interval),\n  co.outcome AS metric,\n  COUNT(*)::integer AS cycles\nFROM coil_outcomes co\nINNER JOIN machines m ON m.id = co.machine_id\nWHERE $__timeFilter(co.created_at)\n  AND m.zone IN ($zone)\n  AND co.machine_id IN ($machine)\nGROUP BY 1, 2\nORDER BY 1 ASC",
          "refId": "A"
