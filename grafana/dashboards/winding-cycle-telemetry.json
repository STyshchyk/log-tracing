          "datasource": {
            "type": "postgres",
            "uid": "telemetry-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  br.created_at AS time,\n  br.id AS report_id,\n  br.machine_id,\n  m.zone,\n  br.tag,\n  br.error_code,\n  eg.title AS glossary_title,\n  br.worker_note,\n  br.status\nFROM bug_reports br\nINNER JOIN machines m ON m.id = br.machine_id\nLEFT JOIN error_glossary eg ON eg.error_code = br.error_code\nWHERE $__timeFilter(br.created_at)\n  AND m.zone IN ($zone)\n  AND br.machine_id IN ($machine)\nORDER BY br.created_at DESC, br.id DESC\nLIMIT 100",
          "refId": "A"
        }
      ],
