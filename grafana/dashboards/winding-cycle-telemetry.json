      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "telemetry-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  COUNT(*) FILTER (WHERE co.outcome = 'AUTO_FINISHED')::integer AS auto_finished,\n  COUNT(*) FILTER (WHERE co.outcome = 'ABORTED')::integer AS aborted,\n  COUNT(*) FILTER (WHERE co.outcome = 'FAULT_TERMINATED')::integer AS fault_terminated,\n  COUNT(*)::integer AS total_cycles,\n  COALESCE(SUM(co.wound_length), 0)::double precision AS total_wound_length\nFROM coil_outcomes co\nINNER JOIN machines m ON m.id = co.machine_id\nWHERE $__timeFilter(co.created_at)\n  AND m.zone IN ($zone)\n  AND co.machine_id IN ($machine)",
          "refId": "A"
        }
      ],
      "title": "ESP32 Cycle Stop Breakdown",
      "type": "stat"
    },
