      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "telemetry-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  COALESCE(co.reason_code, 'UNSPECIFIED') AS reason_code,\n  co.outcome,\n  COALESCE(eg.title, 'No glossary entry') AS glossary_title,\n  MIN(co.machine_id) AS machine_id,\n  COUNT(*)::integer AS cycles,\n  ROUND(AVG(co.duration_sec)::numeric, 1)::double precision AS avg_duration_sec,\n  COALESCE(SUM(co.wound_length), 0)::double precision AS total_wound_length\nFROM coil_outcomes co\nINNER JOIN machines m ON m.id = co.machine_id\nLEFT JOIN error_glossary eg ON eg.error_code = co.reason_code\nWHERE $__timeFilter(co.created_at)\n  AND m.zone IN ($zone)\n  AND co.machine_id IN ($machine)\n  AND co.outcome IN ('ABORTED', 'FAULT_TERMINATED')\nGROUP BY 1, 2, 3\nORDER BY cycles DESC",
          "refId": "A"
        }
      ],
      "title": "Abort & Fault-Termination Reason Breakdown",
      "type": "table"
    },
