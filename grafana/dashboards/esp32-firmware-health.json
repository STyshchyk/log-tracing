                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "machine_id"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "targetBlank": true,
                    "title": "Open Worker Portal",
                    "url": "${app_url}/m/${__data.fields.machine_id}"
                  }
                ]
              }
            ]
          }
        ]
      },
      "gridPos": {
        "h": 8,
        "w": 10,
        "x": 0,
        "y": 16
      },
      "id": 5,
      "options": {
        "cellHeight": "sm",
        "footer": {
          "countRows": false,
          "fields": "",
          "reducer": ["sum"],
          "show": false
        },
        "showHeader": true
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "telemetry-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  COALESCE(te.error_code, te.event_type) AS error_code,\n  COALESCE(eg.title, te.event_type) AS fault_title,\n  COALESCE(te.payload_json->>'subsystem', 'unspecified') AS subsystem,\n  MIN(te.machine_id) AS machine_id,\n  COUNT(*)::integer AS occurrences\nFROM telemetry_events te\nINNER JOIN machines m ON m.id = te.machine_id\nLEFT JOIN error_glossary eg ON eg.error_code = te.error_code\nWHERE $__timeFilter(te.time)\n  AND m.zone IN ($zone)\n  AND te.machine_id IN ($machine)\n  AND (te.error_code IS NOT NULL OR te.event_type IN ('ERROR', 'FAULT', 'SUBSYSTEM_TIMEOUT', 'CRASH_RESET'))\nGROUP BY 1, 2, 3\nORDER BY occurrences DESC",
          "refId": "A"
        }
      ],
      "title": "Fault & Subsystem Timeout Frequency",
      "type": "table"
    },
    {
      "datasource": {
        "type": "postgres",
        "uid": "telemetry-postgres"
      },
      "description": "Recent fault and crash events joined with error_glossary; click machine_id or error_code to open Worker Portal / Glossary.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "inspect": true
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "machine_id"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "targetBlank": true,
                    "title": "Open Worker Portal",
                    "url": "${app_url}/m/${__data.fields.machine_id}"
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "error_code"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "targetBlank": true,
                    "title": "Open Glossary Fix Steps",
                    "url": "${app_url}/m/${__data.fields.machine_id}/glossary?q=${__data.fields.error_code}"
                  }
                ]
              }
            ]
          }
        ]
      },
      "gridPos": {
        "h": 8,
        "w": 14,
        "x": 10,
        "y": 16
      },
      "id": 6,
      "options": {
        "cellHeight": "sm",
        "footer": {
          "countRows": false,
          "fields": "",
          "reducer": ["sum"],
          "show": false
        },
        "showHeader": true
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "telemetry-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  te.time,\n  te.machine_id,\n  m.zone,\n  te.event_type,\n  te.error_code,\n  eg.title AS glossary_title,\n  te.payload_json->>'reset_reason' AS reset_reason,\n  te.payload_json->>'subsystem' AS subsystem,\n  CASE\n    WHEN (te.payload_json->>'rssi') ~ '^-?[0-9]+(\\.[0-9]+)?$' THEN (te.payload_json->>'rssi')::double precision\n  END AS rssi_dbm,\n  CASE\n    WHEN (te.payload_json->>'free_heap') ~ '^[0-9]+$' THEN (te.payload_json->>'free_heap')::bigint\n  END AS free_heap_bytes,\n  te.payload_json->>'message' AS message\nFROM telemetry_events te\nINNER JOIN machines m ON m.id = te.machine_id\nLEFT JOIN error_glossary eg ON eg.error_code = te.error_code\nWHERE $__timeFilter(te.time)\n  AND m.zone IN ($zone)\n  AND te.machine_id IN ($machine)\n  AND (te.error_code IS NOT NULL OR te.event_type IN ('ERROR', 'FAULT', 'SUBSYSTEM_TIMEOUT', 'CRASH_RESET'))\nORDER BY te.time DESC\nLIMIT 100",
          "refId": "A"
        }
      ],
      "title": "Recent Fault Events & Crash Forensics",
      "type": "table"
    }
  ],
