  "panels": [
    {
      "datasource": {
        "type": "postgres",
        "uid": "telemetry-postgres"
      },
      "description": "Counts of ESP32 boot and crash events grouped by esp_reset_reason().",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "options": {
        "barRadius": 0.1,
        "barWidth": 0.7,
        "colorByField": "reset_reason",
        "fullHighlight": false,
        "groupWidth": 0.7,
        "legend": {
          "calcs": [],
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": false
        },
        "orientation": "horizontal",
        "showValue": "always",
        "stacking": "none",
        "tooltip": {
          "mode": "single",
          "sort": "none"
        },
        "xField": "reset_reason",
        "xTickLabelRotation": 0,
        "xTickLabelSpacing": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "telemetry-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT te.payload_json->>'reset_reason' AS reset_reason, COUNT(*)::integer AS events\nFROM telemetry_events te\nINNER JOIN machines m ON m.id = te.machine_id\nWHERE $__timeFilter(te.time)\n  AND m.zone IN ($zone)\n  AND te.machine_id IN ($machine)\n  AND te.payload_json->>'reset_reason' IS NOT NULL\nGROUP BY 1\nORDER BY events DESC",
          "refId": "A"
        }
      ],
      "title": "Crash & Boot Reset Reasons (esp_reset_reason())",
      "type": "barchart"
    },
    {
      "datasource": {
        "type": "postgres",
        "uid": "telemetry-postgres"
      },
      "description": "Time-series trend of CRASH_RESET, brownout, and watchdog reset events.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 75,
            "lineWidth": 1,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "group": "A",
              "mode": "normal"
            }
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "id": 2,
      "options": {
        "legend": {
          "calcs": ["sum"],
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "telemetry-postgres"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT $__timeGroupAlias(te.time, $__interval),\n  COALESCE(te.payload_json->>'reset_reason', te.event_type) AS metric,\n  COUNT(*)::integer AS resets\nFROM telemetry_events te\nINNER JOIN machines m ON m.id = te.machine_id\nWHERE $__timeFilter(te.time)\n  AND m.zone IN ($zone)\n  AND te.machine_id IN ($machine)\n  AND (te.event_type = 'CRASH_RESET' OR te.error_code IN ('ERR_BROWNOUT_RESET', 'ERR_WATCHDOG_RESET'))\nGROUP BY 1, 2\nORDER BY 1 ASC",
          "refId": "A"
        }
      ],
      "title": "Abnormal Crash Resets Over Time",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "postgres",
        "uid": "telemetry-postgres"
      },
      "description": "ESP32 Wi-Fi station RSSI (dBm). Values below -80 dBm indicate high packet-loss risk.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "showPoints": "auto",
            "spanNulls": true,
            "thresholdsStyle": {
              "mode": "line"
            }
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": -80
              },
              {
                "color": "green",
                "value": -70
              }
            ]
          },
          "unit": "dBm"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "id": 3,
      "options": {
        "legend": {
          "calcs": ["lastNotNull", "min", "mean"],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "asc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "telemetry-postgres"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT $__timeGroupAlias(te.time, $__interval),\n  te.machine_id AS metric,\n  AVG((te.payload_json->>'rssi')::double precision) AS rssi_dbm\nFROM telemetry_events te\nINNER JOIN machines m ON m.id = te.machine_id\nWHERE $__timeFilter(te.time)\n  AND m.zone IN ($zone)\n  AND te.machine_id IN ($machine)\n  AND te.payload_json ? 'rssi'\n  AND (te.payload_json->>'rssi') ~ '^-?[0-9]+(\\.[0-9]+)?$'\nGROUP BY 1, 2\nORDER BY 1 ASC",
          "refId": "A"
        }
      ],
      "title": "Wi-Fi Signal Strength (RSSI dBm)",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "postgres",
        "uid": "telemetry-postgres"
      },
      "description": "Free heap and minimum recorded heap watermark (details.min_free_heap) in bytes.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 12,
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "showPoints": "auto",
            "spanNulls": true
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 65536
              },
              {
                "color": "green",
                "value": 100000
              }
            ]
          },
          "unit": "bytes"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "id": 4,
      "options": {
        "legend": {
          "calcs": ["lastNotNull", "min"],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "asc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "telemetry-postgres"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT $__timeGroupAlias(te.time, $__interval),\n  te.machine_id AS metric,\n  AVG((te.payload_json->>'free_heap')::bigint)::double precision AS free_heap_bytes\nFROM telemetry_events te\nINNER JOIN machines m ON m.id = te.machine_id\nWHERE $__timeFilter(te.time)\n  AND m.zone IN ($zone)\n  AND te.machine_id IN ($machine)\n  AND te.payload_json ? 'free_heap'\n  AND (te.payload_json->>'free_heap') ~ '^[0-9]+$'\nGROUP BY 1, 2\nORDER BY 1 ASC",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "postgres",
            "uid": "telemetry-postgres"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT $__timeGroupAlias(te.time, $__interval),\n  te.machine_id || ' (min)' AS metric,\n  MIN((te.payload_json->'details'->>'min_free_heap')::bigint)::double precision AS min_free_heap_bytes\nFROM telemetry_events te\nINNER JOIN machines m ON m.id = te.machine_id\nWHERE $__timeFilter(te.time)\n  AND m.zone IN ($zone)\n  AND te.machine_id IN ($machine)\n  AND (te.payload_json->'details'->>'min_free_heap') ~ '^[0-9]+$'\nGROUP BY 1, 2\nORDER BY 1 ASC",
          "refId": "B"
        }
      ],
      "title": "Free Heap & Min Free Heap (Bytes)",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "postgres",
        "uid": "telemetry-postgres"
      },
      "description": "Most frequent fault codes and subsystem timeouts with deep-links to Worker Portal Glossary.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "inspect": false
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
